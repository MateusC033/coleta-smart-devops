# Copie para .env e preencha. O .env fica fora do git.

# Banco de dados — docker-compose usa estes valores para subir o Postgres
# e para a aplicação se conectar nele pela rede interna do compose.
POSTGRES_DB=coletasmart
POSTGRES_USER=coleta
POSTGRES_PASSWORD=troque-esta-senha

# URL que a aplicação usa para falar com o banco.
# No docker-compose, o host é o nome do serviço do Postgres (db).
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/coletasmart
SPRING_DATASOURCE_USERNAME=coleta
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# JWT — chave aleatória com pelo menos 32 caracteres (256 bits)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRATION=86400000

# Porta exposta pela aplicação
PORT=8080
